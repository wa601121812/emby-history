<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EmbySdkDir Condition="'$(EmbySdkDir)' == ''">../sdk-current</EmbySdkDir>
  </PropertyGroup>
  <ItemGroup>
    <!-- Exercise the actual worker and scan, not a copy of their control flow. -->
    <Compile Include="../Plugin/EntryPoint.cs" Link="Production/EntryPoint.cs" />
    <Compile Include="../Plugin/HistoryWorkPlanner.cs" Link="Production/HistoryWorkPlanner.cs" />
    <Compile Include="../Plugin/HistoryStatusService.cs" Link="Production/HistoryStatusService.cs" />
    <Compile Include="../Plugin/Configuration.cs" Link="Production/Configuration.cs" />
    <Compile Include="../Plugin/PosterCache.cs" Link="Production/PosterCache.cs" />
    <Compile Include="../Core/*.cs" Link="Production/Core/%(Filename)%(Extension)" />
    <Reference Include="Emby.Naming"><HintPath>sdk-dependencies/Emby.Naming.dll</HintPath></Reference>
    <Reference Include="Emby.Media.Model"><HintPath>sdk-dependencies/Emby.Media.Model.dll</HintPath></Reference>
    <Reference Include="Emby.Extensions"><HintPath>sdk-dependencies/Emby.Extensions.dll</HintPath></Reference>
    <Reference Include="MediaBrowser.Controller"><HintPath>$(EmbySdkDir)/MediaBrowser.Controller.dll</HintPath></Reference>
    <Reference Include="MediaBrowser.Common"><HintPath>$(EmbySdkDir)/MediaBrowser.Common.dll</HintPath></Reference>
    <Reference Include="MediaBrowser.Model"><HintPath>$(EmbySdkDir)/MediaBrowser.Model.dll</HintPath></Reference>
  </ItemGroup>
</Project>
